    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@types/node": "24.10.0",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "cross-spawn": "7.0.6",
    "esbuild": "0.25.12",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "zod": "4.3.6",
    "dsh-identity-client": "link:../dsh-identity/client"
