{
  "name": "dsh-frontvia-customer",
  "version": "0.1.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./src/core.ts",
      "default": "./dist/core.js"
    },
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "@awiki/dsh-pap": "0.1.5",
    "@agent-network-protocol/dsh-anp-identity": "0.1.16"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "1.2.1",
    "entities": "8.1.0",
    "lucide-react": "1.66.0",
    "marked": "18.1.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "react-dom": "18.3.1",
    "@awiki/dsh-pap": "0.1.5",
    "@agent-network-protocol/dsh-anp-identity": "0.1.16"
  },
  "description": "Frontvia 商品、购物车、购买确认、订单及咨询插件。",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentConnect/dsh-frontvia-plugins.git",
    "directory": "packages/customer"
  }
}
